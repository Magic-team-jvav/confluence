{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:stellar_studies_constellation",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "confluence:stellar_studies_constellation"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 14,
				"max_particles": 36
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, 0]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = 0.26 - (variable.particle_age / variable.particle_lifetime) * 0.2;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.1
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 1.35,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.45, 0],
				"linear_drag_coefficient": 1.6
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 16,
					"uv": ["math.floor(variable.particle_random_1 * 4) * 16", 0],
					"uv_size": [16, 16]
				}
			}
		}
	}
}
