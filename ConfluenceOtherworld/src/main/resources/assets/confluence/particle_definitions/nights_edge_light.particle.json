{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:nights_edge_light",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "confluence:nights_edge_light"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 6
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.2,
				"direction": "inwards"
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = 1 - (math.pow((v.particle_age / v.particle_lifetime - 1), 2)) * (0.5 + v.particle_random_1 * 0.5);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.35,0.5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": -135
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [0, 0, "-v.size * 6"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size * 4.2", "v.size * 4.2"],
				"facing_camera_mode": "direction_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.31": "#FF9C00FF",
						"1.0": "#0016002A"
					}
				}
			}
		}
	}
}