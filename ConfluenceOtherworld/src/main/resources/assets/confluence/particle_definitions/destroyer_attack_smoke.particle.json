{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_smoke",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "confluence:destroyer_attack/dirt"
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 15,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_looping": {
                "active_time": 1
            },
            "minecraft:emitter_shape_sphere": {
                "radius": 2
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.size = 2 + (4 + 4 * v.particle_random_1) * (v.particle_age / v.particle_lifetime);"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 1
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(-180, 180)",
                "rotation_rate": "math.random(-180, 180)"
            },
            "minecraft:particle_initial_speed": "math.random(3,10)",
            "minecraft:particle_motion_dynamic": {
                "rotation_drag_coefficient": 1
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "v.size",
                    "v.size"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#FFFFFFFF",
                        "0.32": "#FFFFEE00",
                        "0.56": "#FFFF0000",
                        "0.79": "#73000000",
                        "1.0": "#009A7B6C"
                    }
                }
            }
        }
    }
}
