{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:blood",
			"basic_render_parameters": {
                "material": "particles_blend",
                "texture": "confluence:blood"
            }
        },
        "events": {
            "event": {
                "expression": "v.bl = 1"
			}
		},
		"components": {
            "minecraft:emitter_rate_instant": {
                "num_particles": 50
			},
            "minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
                "offset": [
                    0,
                    1,
                    0
                ]
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.colorR = 255;v.colorG = 0;v.colorB = 0;"
			},
			"minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(0.5, 2)"
			},
            "minecraft:particle_initial_speed": "math.random(1, 8)",
			"minecraft:particle_motion_dynamic": {
                "linear_acceleration": [
                    0,
                    -25,
                    0
                ]
            },
            "minecraft:particle_motion_parametric": {
                "rotation": "v.bl ? (v.particle_random_1 * 720) : 0"
			},
			"minecraft:particle_appearance_billboard": {
                "size": [
                    "v.bl ? (0.2 + 0.2 * v.particle_random_3) : (0.03 + 0.03 * v.particle_random_4)",
                    "v.bl ? (0.2 + 0.2 * v.particle_random_3) : (0.1 + 0.1 * v.particle_random_4)"
                ],
                "facing_camera_mode": "direction_y",
                "direction": {
                    "mode": "derive_from_velocity",
                    "min_speed_threshold": -100
                },
				"uv": {
                    "texture_width": 32,
					"texture_height": 16,
                    "uv": [
                        "v.bl ? (math.floor(v.particle_random_1 * 2) * 8) : 16",
                        "math.floor(v.particle_random_2 * 2) * 8"
                    ],
					"uv_size": [8, 8]
				}
			},
            "minecraft:particle_motion_collision": {
                "collision_drag": 100,
                "collision_radius": 0.2,
                "events": [
                    {
                        "event": "event",
                        "min_speed": 0
                    }
                ]
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    "v.colorR / 255 * (0.5 + 0.5 * v.particle_random_4)",
                    "v.colorG / 255 ",
                    "v.colorB / 255",
                    "v.bl ? math.sqrt(1 - v.particle_age / v.particle_lifetime) : 1"
                ]
            }
		}
	}
}