{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:bei_dou_rune",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "confluence:stellar_studies_rune"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 80,
				"max_particles": 120
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0, 0],
				"radius": 0.6,
				"direction": "inwards",
				"surface_only": true
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = (0.18 - (variable.particle_age / variable.particle_lifetime) * 0.12) * (0.8 + variable.particle_random_2 * 0.4);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.45
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 1.0,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2.8
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 536,
					"texture_height": 8,
					"uv": ["math.floor(variable.rune) * 8", 0],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.red", "variable.green", "variable.blue", 0.9]
			}
		}
	}
}
