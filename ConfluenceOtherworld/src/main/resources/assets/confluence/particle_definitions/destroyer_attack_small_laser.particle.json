{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_small_laser",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:destroyer_small_laser/laser"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 20,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_expression": {},
            "minecraft:emitter_shape_sphere": {
                "radius": 0.1,
                "direction": "outwards"
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.p = v.particle_age / v.particle_lifetime;v.size = (1 - (v.p - 1) * (v.p - 1)) * 0.44 * math.random(0.8,1);"
            },
            "minecraft:particle_lifetime_expression": {
                "expiration_expression": "variable.laser_active < 0.5",
                "max_lifetime": 1
            },
            "minecraft:particle_initial_spin": {
                "rotation": -50
            },
            "minecraft:particle_initial_speed": 0,
            "minecraft:particle_motion_dynamic": {},
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "v.size",
                    "v.size"
                ],
                "facing_camera_mode": "lookat_direction",
                "direction": {
                    "mode": "custom",
                    "custom_direction": [
                        0,
                        1,
                        0
                    ]
                },
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#ffffffff",
                        "0.88": "#FFFF0000"
                    }
                }
            }
        }
    }
}
