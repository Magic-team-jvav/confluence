{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_ball",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:destroyer_attack/inner"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 13,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 6
            },
            "minecraft:emitter_shape_sphere": {
                "radius": 0.5
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.x = (v.emitter_age / v.emitter_lifetime);v.ab = 0.005 - math.abs(v.x - 0.995);v.up1 = (v.ab / 2 / math.abs(v.ab) + 0.5) * 10;v.size = (math.random(0.8, 1.1) * v.x) * 10 + v.up1;"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 1
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(-180, 180)",
                "rotation_rate": "math.random(-180, 180)"
            },
            "minecraft:particle_initial_speed": 0,
            "minecraft:particle_motion_dynamic": {},
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "v.size * 0.5",
                    "v.size * 0.5"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#FFFF0000",
                        "0.65": "#FFFF0000",
                        "1.0": "#FFFFFFFF"
                    }
                }
            }
        }
    }
}
