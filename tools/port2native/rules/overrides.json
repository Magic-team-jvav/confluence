{
  "_note": "规则治理文件（人工裁决，优先级最高）。引擎在加载完全部规则后应用本文件的四项动作：disable（明确禁用某条规则）、promote（把已核实的 review 提升为可自动应用）、busAware（replace 里的 BUS 需按事件类型解析）、extraRules（追加人工核实的新规则）。每条都写明依据。",
  "disable": [
    "port-attachmenttype-build",
    "port-datamaptype-build",
    "port-datamaptype-codec",
    "port-registration-register",
    "port-itemstack-component-accessors",
    "port-attributemodifier-id",
    "port-existingdata-holder-arg",
    "port-ipacket-identifier",
    "port-ipacket-s2c",
    "port-backported-blocks"
  ],
  "promote": [
    "list-extension-getfirst",
    "list-extension-getlast",
    "list-extension-addfirst",
    "list-extension-addlast",
    "list-extension-removefirst",
    "list-extension-removelast",
    "port-payloadhandler-registerInGameS2C",
    "port-payloadhandler-registerInGameC2S",
    "port-payloadhandler-registerLoginS2C",
    "port-payloadhandler-registerLoginC2S",
    "port-payloadhandler-registerInGameBidirectional"
  ],
  "busAware": [
    "port-eventhandler-addlistener-1",
    "port-eventhandler-postevent",
    "port-eventhandler-posteventwithreturn",
    "local-eventhandler-addlistener-generic"
  ],
  "extraRules": [
    {
      "id": "local-eventhandler-addlistener-generic",
      "pattern": "\\bPortEventHandler\\.addListener\\(",
      "replace": "BUS.addListener(",
      "kind": "safe",
      "typeImports": ["net.neoforged.neoforge.common.NeoForge"],
      "notes": "兜住那些没被专门规则命中的形式（方法引用、带括号参数的 lambda）。BUS 由引擎按调用点附近的事件类型解析：全游戏总线 -> NeoForge.EVENT_BUS；含模组总线事件或解析不出 -> 不改写并进人工清单（模组总线必须用 @Mod 构造器拿到的 IEventBus，写错能编译但静默不触发）。"
    },
    {
      "id": "local-soundevents-backported",
      "pattern": "\\bPortSoundEvents\\.([A-Z][A-Z_0-9]*)\\.get\\(\\)",
      "replace": "SoundEvents.\\1",
      "kind": "safe",
      "typeImports": ["net.minecraft.sounds.SoundEvents"],
      "notes": "PortSoundEvents 的 26 个常量都是 1.21.1 原生 SoundEvents 的常量（已核实 COPPER_BULB_TURN_ON SoundEvents.java:355、COPPER_BULB_TURN_OFF :356、WET_SPONGE_BREAK :1529、TUFF_BRICKS_PLACE :1413、POLISHED_TUFF_PLACE :1418 等）。原生是普通 SoundEvent 字段，故要把 PortLib 的 Holder 取值 .get() 一起去掉。"
    },
    {
      "id": "local-soundeventholder-backported",
      "pattern": "\\bPortSoundEvents\\.([A-Z][A-Z_0-9]*)\\b(?!\\.get\\(\\))",
      "replace": "SoundEvents.\\1",
      "kind": "review",
      "typeImports": ["net.minecraft.sounds.SoundEvents"],
      "notes": "同上，但调用点没有 .get()（例如作为 Holder 直接传参）。这种要人工确认接收方是 SoundEvent 还是 Holder<SoundEvent>。"
    }
  ]
}
