{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "confluence:wind_eye_tornado",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "confluence:spark_projectile"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 80,
        "max_particles": 200
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7, 1.15)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 900 + v.particle_random_1 * 360) * (0.12 + v.particle_age * 1.7)",
          "v.particle_age * 4.8 + v.particle_random_2 * 0.2",
          "math.sin(v.particle_age * 900 + v.particle_random_1 * 360) * (0.12 + v.particle_age * 1.7)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.14 * (1.0 - v.particle_age / v.particle_lifetime * 0.55)",
          "0.14 * (1.0 - v.particle_age / v.particle_lifetime * 0.55)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [0.62, 0.92, 1.0, "math.clamp(1.0 - v.particle_age / v.particle_lifetime, 0.0, 1.0)"]
      }
    }
  }
}
