{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_laser",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:destroyer_attack/null"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 300,
                "max_particles": 1000
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 10
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.ag = 0.01 + 0.5 * (1 / (10 * math.pow(v.emitter_age + 0.31, 2)));"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 1
            },
            "minecraft:particle_initial_speed": "math.random(500,900)",
            "minecraft:particle_motion_dynamic": {},
            "minecraft:particle_appearance_billboard": {
                "size": [
                    30,
                    "(2 + (v.particle_age / v.particle_lifetime) * 20) * 0.5"
                ],
                "facing_camera_mode": "lookat_direction",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    1,
                    "v.particle_random_1 * (1 - v.particle_age / v.particle_lifetime)",
                    "v.particle_random_1 * (1 - v.particle_age / v.particle_lifetime)",
                    "v.particle_random_2 * (1 - v.particle_age / v.particle_lifetime)"
                ]
            },
            "minecraft:emitter_shape_box": {
                "offset": [
                    0,
                    31,
                    0
                ],
                "half_dimensions": [
                    0.25,
                    0.25,
                    0.25
                ],
                "direction": [
                    "math.random(-v.ag * 0.1, v.ag * 0.1)",
                    1,
                    "math.random(-v.ag * 0.1, v.ag * 0.1)"
                ]
            }
        }
    }
}
