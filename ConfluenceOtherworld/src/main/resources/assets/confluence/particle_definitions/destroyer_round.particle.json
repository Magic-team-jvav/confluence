{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_round",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:destroyer_round"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": "50 * variable.destroyer_exhaust_strength",
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_expression": {},
            "minecraft:emitter_shape_point": {},
            "minecraft:particle_initialization": {
                "per_render_expression": "v.a = math.floor(v.particle_random_1 * 2);v.size = (4 - v.a) * 0.18;"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(0.1,0.2)"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(-180, 180)",
                "rotation_rate": "math.random(-180, 180)"
            },
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    "math.random(-0.05,0.05)",
                    "-(v.a / 1.5 + 0.5 + math.random(-0.05,0.05))",
                    "math.random(-0.05,0.05)"
                ]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "(v.size) * (0.6 + 0.4 * variable.destroyer_exhaust)",
                    "(v.size) * (0.6 + 0.4 * variable.destroyer_exhaust)"
                ],
                "facing_camera_mode": "emitter_transform_xz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#ffffffff",
                        "0.46": "#FF00ACFF",
                        "0.64": "#FFFFF500",
                        "0.84": "#FFFF0000",
                        "1.0": "#ff000000"
                    }
                }
            }
        }
    }
}