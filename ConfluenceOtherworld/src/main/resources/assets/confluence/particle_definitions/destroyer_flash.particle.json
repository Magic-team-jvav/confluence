{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:destroyer_flash",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "confluence:destroyer_null"
			}
		},
		"components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 40,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.3,
				"direction": ["math.random(-0.1, 0.1)", -1, "math.random(-0.1, 0.1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_speed": "math.random(7,15)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.02 + (1 - (v.particle_age / v.particle_lifetime)) * 0.18", 0.02],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.19": "#FF00F8FF",
						"0.27": "#FFFFF400",
						"0.52": "#C9FF0000",
						"1.0": "#00260000"
					}
				}
			}
		}
	}
}