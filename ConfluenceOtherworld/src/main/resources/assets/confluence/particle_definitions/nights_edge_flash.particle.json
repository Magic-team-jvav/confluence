{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:nights_edge_flash",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "confluence:nights_edge_flash"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1000,
				"max_particles": 400
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.4
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-1, 1) ", "math.random(-0.2,0.2)", "-v.size * math.random(0, 12)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = math.max(1 - math.pow((v.emitter_age / v.emitter_lifetime - 1), 2), 0.15);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2, 0.5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "math.random(-400, 400) "
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.05 + 0.15 * v.particle_random_1", "0.05 + 0.15 * v.particle_random_1"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.5": "#FFB600FF",
						"1.0": "#00050008"
					}
				}
			}
		}
	}
}