{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_inner",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:destroyer_attack/null"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 75,
                "max_particles": 300
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 4
            },
            "minecraft:emitter_shape_sphere": {
                "radius": 9.5,
                "surface_only": true,
                "direction": "inwards"
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.r = 30 * math.pow(v.particle_random_1, 1 / 3);v.q = 360 * v.particle_random_2;v.h = 2 * v.particle_random_3 - 1;v.b = v.r * math.sqrt(1 - v.h * v.h);v.x = v.b * math.cos(v.q);v.y = v.b * math.sin(v.q) * 0.35;v.z = v.r * v.h;v.p = v.particle_age / v.particle_lifetime;v.rotate = 200 * v.p;v.size = v.p * math.random(0.8,1.5) * 1.2;"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "1 + 2 * math.pow(math.random(0,1), 2)"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(-180, 180)"
            },
            "minecraft:particle_initial_speed": 9.5,
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    "(v.x * math.cos(v.p * v.rotate) + v.z * math.sin(v.p * v.rotate)) * (1 - v.p)",
                    "v.y * (1 - v.p)",
                    "(v.x * math.sin(v.p * v.rotate) - v.z * math.cos(v.p * v.rotate)) * (1 - v.p)"
                ]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "v.size",
                    "v.size"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.5": "#FFFF0000",
                        "1.0": "#ffffffff"
                    }
                }
            }
        }
    }
}
