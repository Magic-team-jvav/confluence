{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_small_laser_1",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:destroyer_null"
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 100,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_expression": {},
            "minecraft:emitter_shape_sphere": {
                "radius": 0.175,
                "direction": [
                    "v.laser_dx",
                    "v.laser_dy",
                    "v.laser_dz"
                ]
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.size = (1 - (v.particle_age / v.particle_lifetime)) * 0.25;"
            },
            "minecraft:particle_lifetime_expression": {
                "expiration_expression": "variable.laser_active < 0.5",
                "max_lifetime": "math.random(0.1,0.2)"
            },
            "minecraft:particle_initial_speed": "math.random(4, 20)",
            "minecraft:particle_motion_dynamic": {},
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "v.size",
                    "v.size * 0.25"
                ],
                "facing_camera_mode": "lookat_direction",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#ffffffff",
                        "0.46": "#FFFF0000"
                    }
                }
            }
        }
    }
}
