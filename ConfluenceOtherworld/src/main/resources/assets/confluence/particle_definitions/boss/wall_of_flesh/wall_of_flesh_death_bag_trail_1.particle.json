{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:wall_of_flesh_death_bag_trail_1",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:ambient/evil_granule"
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 30,
                "max_particles": 100
            },
            "minecraft:emitter_shape_point": {},
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 6
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(-180, 180)"
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    0.3,
                    0.3
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 128,
                    "flipbook": {
                        "base_UV": [
                            "Math.floor(v.particle_random_3 * 2) * 8",
                            "Math.floor(v.particle_random_4 * 2) * 8"
                        ],
                        "size_UV": [
                            8,
                            8
                        ],
                        "step_UV": [
                            0,
                            16
                        ],
                        "frames_per_second": 12,
                        "max_frame": 8,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.6
            },
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    "variable.target_x * variable.particle_age / 6 + 0.4 * math.sin(variable.particle_age * 30) * (variable.side_x * math.cos(variable.particle_age * 180) + variable.up_x * math.sin(variable.particle_age * 180))",
                    "variable.target_y * variable.particle_age / 6 + 0.4 * math.sin(variable.particle_age * 30) * (variable.side_y * math.cos(variable.particle_age * 180) + variable.up_y * math.sin(variable.particle_age * 180))",
                    "variable.target_z * variable.particle_age / 6 + 0.4 * math.sin(variable.particle_age * 30) * (variable.side_z * math.cos(variable.particle_age * 180) + variable.up_z * math.sin(variable.particle_age * 180))"
                ]
            }
        }
    }
}
