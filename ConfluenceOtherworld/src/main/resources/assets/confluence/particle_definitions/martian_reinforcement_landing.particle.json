{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:martian_reinforcement_landing",
            "basic_render_parameters": {
                "material": "particles_alpha",
                "texture": "confluence:bomb_smoke"
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.radius = math.clamp(variable.radius > 0 ? variable.radius : 1, 0.45, 3);"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": 28
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_disc": {
                "offset": [
                    0,
                    0.08,
                    0
                ],
                "radius": "variable.radius * 0.35",
                "plane_normal": "y",
                "direction": "outwards",
                "surface_only": true
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "0.5 + variable.particle_random_2 * 0.35"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "variable.particle_random_1 * 360"
            },
            "minecraft:particle_initial_speed": "variable.radius * (2.4 + variable.particle_random_1 * 1.8)",
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [
                    0,
                    -0.8,
                    0
                ],
                "linear_drag_coefficient": 3.5
            },
            "minecraft:particle_motion_collision": {
                "collision_drag": 0.8,
                "coefficient_of_restitution": 0.1,
                "collision_radius": 0.04
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "(variable.particle_random_4 > 0.8 ? 0.04 + variable.particle_random_3 * 0.035 : 0.13 + variable.particle_random_3 * 0.12) * variable.radius * (1 + 0.8 * variable.particle_age / variable.particle_lifetime)",
                    "(variable.particle_random_4 > 0.8 ? 0.04 + variable.particle_random_3 * 0.035 : 0.13 + variable.particle_random_3 * 0.12) * variable.radius * (1 + 0.8 * variable.particle_age / variable.particle_lifetime)"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 8,
                    "texture_height": 64,
                    "flipbook": {
                        "base_UV": [
                            0,
                            0
                        ],
                        "size_UV": [
                            8,
                            8
                        ],
                        "step_UV": [
                            0,
                            8
                        ],
                        "frames_per_second": 12,
                        "max_frame": 8,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "variable.particle_age / variable.particle_lifetime",
                    "gradient": {
                        "0.0": [
                            1,
                            "variable.particle_random_4 > 0.8 ? 0.5 : 0.38",
                            0.2,
                            0.9
                        ],
                        "0.15": [
                            "variable.particle_random_4 > 0.8 ? 1 : 0.68",
                            0.22,
                            0.16,
                            0.78
                        ],
                        "0.6": [
                            "variable.particle_random_4 > 0.8 ? 0.8 : 0.32",
                            0.12,
                            0.1,
                            0.4
                        ],
                        "1.0": [
                            0.25,
                            0.08,
                            0.06,
                            0
                        ]
                    }
                }
            }
        }
    }
}
