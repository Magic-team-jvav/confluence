{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_small_laser_round",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:bomb_round"
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 40,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_expression": {},
            "minecraft:emitter_shape_point": {
                "direction": [
                    "v.laser_dx",
                    "v.laser_dy",
                    "v.laser_dz"
                ]
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.rotate = v.particle_random_1 * 360;v.size = (1 - v.particle_age / v.particle_lifetime) * (0.2 + 0.2 * v.emitter_random_2);"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(0.1,0.2)"
            },
            "minecraft:particle_initial_speed": "math.random(5,20)",
            "minecraft:particle_motion_dynamic": {},
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "v.size",
                    "v.size"
                ],
                "facing_camera_mode": "direction_z",
                "direction": {
                    "mode": "custom",
                    "custom_direction": [
                        "math.sin(v.rotate) * 0.75 * v.laser_basis_00 + v.laser_basis_10 + math.cos(v.rotate) * 0.75 * v.laser_basis_20",
                        "math.sin(v.rotate) * 0.75 * v.laser_basis_01 + v.laser_basis_11 + math.cos(v.rotate) * 0.75 * v.laser_basis_21",
                        "math.sin(v.rotate) * 0.75 * v.laser_basis_02 + v.laser_basis_12 + math.cos(v.rotate) * 0.75 * v.laser_basis_22"
                    ]
                },
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#ffffffff",
                        "0.21": "#FFFF0000"
                    }
                }
            }
        }
    }
}
