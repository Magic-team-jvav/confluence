{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:destroyer_attack_out",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:destroyer_attack/inner"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 70,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 9
            },
            "minecraft:emitter_shape_sphere": {
                "radius": 7,
                "surface_only": true
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "v.p = v.particle_age / v.particle_lifetime;v.rotate = 360 * v.particle_random_2;v.size = (1 - v.p) * (1 + 2 * (v.particle_random_1));"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(0.3,0.9)"
            },
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    "math.sin(v.rotate + v.p * 180) * v.p * 50 * v.particle_random_4",
                    "v.p * (30 + 100 * v.particle_random_1) * v.particle_random_3",
                    "math.cos(v.rotate + v.p * 180) * v.p * 50 * v.particle_random_4"
                ]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "v.size",
                    "v.size"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#FFFFFFFF",
                        "0.35": "#FFFF0000",
                        "1.0": "#ff000000"
                    }
                }
            }
        }
    }
}
