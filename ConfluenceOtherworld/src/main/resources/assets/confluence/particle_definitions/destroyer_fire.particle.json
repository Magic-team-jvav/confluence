{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:destroyer_fire",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "confluence:destroyer_fire"
			}
		},
		"components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 80,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"direction": [0, -1, 0]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = 1 - (v.particle_age / v.particle_lifetime) / 2;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2,0.3)"
			},
			"minecraft:particle_initial_speed": "math.random(3,18)",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.2 * v.size", "0.5 / v.size"],
				"facing_camera_mode": "lookat_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.02": "#FF0078FF",
						"0.36": "#FF00E5FF",
						"0.4": "#FFFFC700",
						"0.74": "#FFFF0500",
						"1.0": "#00260000"
					}
				}
			}
		}
	}
}