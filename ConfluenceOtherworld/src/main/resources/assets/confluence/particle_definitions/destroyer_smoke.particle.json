{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "confluence:destroyer_smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "confluence:destroyer_smoke"
			}
		},
		"components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": true
            },
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 25,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.5, 0],
				"direction": ["math.random(-0.05,0.05)", -1, "math.random(-0.05,0.05)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = v.particle_age / v.particle_lifetime + 1;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 7.5,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.25 + (v.particle_random_1 * 0.2)) * v.size", "(0.25 + (v.particle_random_1 * 0.2)) * v.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 12,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.12": "#00FFFFFF",
						"0.3": "#FFB4A391",
						"0.52": "#FF453D3D",
						"1.0": "#00000000"
					}
				}
			}
		}
	}
}