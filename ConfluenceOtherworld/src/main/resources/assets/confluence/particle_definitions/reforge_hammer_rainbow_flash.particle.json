{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "confluence:reforge_hammer_rainbow_flash",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "confluence:reforge_hammer_flash"
            }
        },
        "components": {
            "minecraft:emitter_rate_instant": {
                "num_particles": 50
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_point": {},
            "minecraft:particle_initialization": {
                "per_render_expression": "v.size = math.floor(v.particle_random_1 * 2);v.h = v.particle_random_2 * 360;v.r = math.clamp(2.0-math.abs(math.mod(v.h/60.0,6.0)-3.0),0.0,1.0);v.g = math.clamp(2.0-math.abs(math.mod(v.h/60.0+4.0,6.0)-3.0),0.0,1.0);v.b = math.clamp(2.0-math.abs(math.mod(v.h/60.0+2.0,6.0)-3.0),0.0,1.0);v.p = (v.particle_age / v.particle_lifetime);v.t = (1 + math.pow(v.p - 1, 3));"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(0.1, 0.25)  * v.size + (1 - v.size) * math.random(0.4,0.6)"
            },
            "minecraft:particle_initial_speed": "math.random(3,8)",
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [
                    0,
                    "-40 * v.size",
                    0
                ],
                "linear_drag_coefficient": 0.5
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "0.1 * v.size + (1 - v.size) * 0.05",
                    "0.01 * v.size + (1 - v.size) * 0.05"
                ],
                "facing_camera_mode": "lookat_direction",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    "v.r * v.t + 1 - v.t",
                    "v.g * v.t + 1 - v.t",
                    "v.b * v.t + 1 - v.t",
                    "1 - v.p"
                ]
            }
        }
    }
}
